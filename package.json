{
  "name": "rest-api-harness",
  "version": "0.1.0",
  "description": "An agent harness that governs TypeScript REST API work (greenfield + brownfield) across model providers.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "harness": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "harness": "tsx src/cli.ts",
    "check": "tsx src/cli.ts check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "openai": "^7.28.0",
    "typescript": "^5.6.0",
    "yaml": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "vitest": "^3.0.0"
  }
}
